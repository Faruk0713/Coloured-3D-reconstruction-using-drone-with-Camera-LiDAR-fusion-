<?xml version="1.0"?>
<robot name="lidar_drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========== BASE BODY ========== -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.35 0.35 0.08"/></geometry>
      <material name="dark_grey"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.35 0.35 0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <inertia ixx="0.015" iyy="0.015" izz="0.025" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ========== ARMS ========== -->
  <link name="arm_fl">
    <visual><geometry><box size="0.18 0.025 0.02"/></geometry></visual>
    <inertial><mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="arm_fl_joint" type="fixed">
    <parent link="base_link"/><child link="arm_fl"/>
    <origin xyz="0.12 0.12 0.0" rpy="0 0 0.785"/>
  </joint>

  <link name="arm_fr">
    <visual><geometry><box size="0.18 0.025 0.02"/></geometry></visual>
    <inertial><mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="arm_fr_joint" type="fixed">
    <parent link="base_link"/><child link="arm_fr"/>
    <origin xyz="0.12 -0.12 0.0" rpy="0 0 -0.785"/>
  </joint>

  <link name="arm_rl">
    <visual><geometry><box size="0.18 0.025 0.02"/></geometry></visual>
    <inertial><mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="arm_rl_joint" type="fixed">
    <parent link="base_link"/><child link="arm_rl"/>
    <origin xyz="-0.12 0.12 0.0" rpy="0 0 -0.785"/>
  </joint>

  <link name="arm_rr">
    <visual><geometry><box size="0.18 0.025 0.02"/></geometry></visual>
    <inertial><mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="arm_rr_joint" type="fixed">
    <parent link="base_link"/><child link="arm_rr"/>
    <origin xyz="-0.12 -0.12 0.0" rpy="0 0 0.785"/>
  </joint>

  <!-- ========== ROTORS ========== -->
  <link name="rotor_fl">
    <visual><geometry><cylinder radius="0.1" length="0.01"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 0.8"/></material>
    </visual>
    <inertial><mass value="0.025"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rotor_fl_joint" type="fixed">
    <parent link="base_link"/><child link="rotor_fl"/>
    <origin xyz="0.17 0.17 0.02" rpy="0 0 0"/>
  </joint>

  <link name="rotor_fr">
    <visual><geometry><cylinder radius="0.1" length="0.01"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 0.8"/></material>
    </visual>
    <inertial><mass value="0.025"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rotor_fr_joint" type="fixed">
    <parent link="base_link"/><child link="rotor_fr"/>
    <origin xyz="0.17 -0.17 0.02" rpy="0 0 0"/>
  </joint>

  <link name="rotor_rl">
    <visual><geometry><cylinder radius="0.1" length="0.01"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 0.8"/></material>
    </visual>
    <inertial><mass value="0.025"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rotor_rl_joint" type="fixed">
    <parent link="base_link"/><child link="rotor_rl"/>
    <origin xyz="-0.17 0.17 0.02" rpy="0 0 0"/>
  </joint>

  <link name="rotor_rr">
    <visual><geometry><cylinder radius="0.1" length="0.01"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 0.8"/></material>
    </visual>
    <inertial><mass value="0.025"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rotor_rr_joint" type="fixed">
    <parent link="base_link"/><child link="rotor_rr"/>
    <origin xyz="-0.17 -0.17 0.02" rpy="0 0 0"/>
  </joint>

  <!-- ========== VELODYNE VLP-16 ========== -->
  <link name="velodyne_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.07"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.07"/></geometry>
    </collision>
    <inertial><mass value="0.08"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="velodyne_joint" type="fixed">
    <parent link="base_link"/><child link="velodyne_link"/>
    <origin xyz="0.0 0.0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- ========== FRONT CAMERA ========== -->
  <link name="front_camera_link">
    <visual>
      <geometry><box size="0.03 0.06 0.03"/></geometry>
      <material name="red"><color rgba="0.8 0.1 0.1 1"/></material>
    </visual>
    <inertial><mass value="0.02"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/><child link="front_camera_link"/>
    <origin xyz="0.18 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ========== GAZEBO: Flight Plugin ========== -->
  <gazebo>
    <plugin name="lidar_drone_plugin" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/lidar_drone</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <publish_rate>10</publish_rate>
    </plugin>
  </gazebo>

  <!-- ========== GAZEBO: Velodyne VLP-16 ========== -->
  <gazebo reference="velodyne_link">
    <sensor name="velodyne" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.2618</min_angle>
            <max_angle>0.2618</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>100.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="velodyne_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/lidar_drone</namespace>
          <remapping>~/out:=lidar/points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>velodyne_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ========== GAZEBO: Front Camera ========== -->
  <gazebo reference="front_camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <plugin name="front_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/lidar_drone</namespace>
          <remapping>image_raw:=front_camera/image_raw</remapping>
          <remapping>camera_info:=front_camera/camera_info</remapping>
        </ros>
        <frame_name>front_camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>